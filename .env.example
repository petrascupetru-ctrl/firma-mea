# Notificări push (opțional) — vezi SETUP-NOTIFICARI.md
# Stocare abonamente (Vercel KV le adaugă automat; sau Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Chei VAPID pentru Web Push (generează cu: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protejează endpoint-ul de cron (Vercel îl trimite ca Bearer token)
CRON_SECRET=

# Asistent AI (opțional) — vezi SETUP-ASISTENT-AI.md
# Cheie de la console.anthropic.com; stă doar pe server.
ANTHROPIC_API_KEY=
# Model opțional (implicit claude-opus-4-8)
AI_MODEL=
